NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Unique per process; shows up in logs and in the SSE `hello` event.
INSTANCE_ID=api-local-1

DATABASE_URL=postgres://notify:notify@localhost:5432/notify
REDIS_URL=redis://localhost:6379

# >= 32 characters. Subscriber tokens only; API keys are hashed with SHA-256.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

LOG_LEVEL=info
BODY_LIMIT=16384

# Realtime
INLINE_RECIPIENT_LIMIT=100
FANOUT_CHUNK_SIZE=500
MAX_CONNECTIONS_PER_USER=5
MAX_CONNECTIONS_PER_INSTANCE=10000
CONNECTION_QUEUE_MAX=100
CONNECTION_QUEUE_BYTES=1000000
REPLAY_LIMIT=500
HEARTBEAT_INTERVAL_MS=20000
STREAM_TICKET_TTL_SECONDS=30
SUBSCRIBER_TOKEN_TTL_SECONDS=900

# Rate limiting
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
STREAM_RATE_LIMIT_MAX=30
STREAM_RATE_LIMIT_WINDOW=1 minute

# Channels
SMTP_URL=
EMAIL_FROM=notifications@example.test
WORKER_CONCURRENCY=10
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RESPONSE_BYTES=8192
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_IPS=false
ESCALATION_DELAY_MS=600000
RETENTION_DAYS=30

# Demo UI
DEMO_ENABLED=false
DEMO_APP_ID=demo
CORS_ORIGIN=*

# Metrics
METRICS_ENABLED=true
WORKER_METRICS_PORT=9464
