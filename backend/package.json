{
  "name": "notification-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/src/worker.js",
    "migrate": "node-pg-migrate up -m src/db/migrations",
    "migrate:down": "node-pg-migrate down -m src/db/migrations",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "seed:key": "tsx scripts/seed-key.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@fastify/under-pressure": "^9.0.3",
    "@fastify/websocket": "^11.0.2",
    "@sinclair/typebox": "^0.34.31",
    "bullmq": "^5.41.0",
    "env-schema": "^6.1.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.6.0",
    "kysely": "^0.28.0",
    "node-pg-migrate": "^7.9.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.14.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "undici": "^7.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.20.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "eslint": "^9.22.0",
    "eventsource": "^3.0.5",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "testcontainers": "^10.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8",
    "ws": "^8.18.1"
  }
}
